# Meta / Instagram App (produto "Instagram API with Instagram Login")
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# URL publica (tunel ngrok/cloudflared) usada no redirect_uri do OAuth
API_HOST=https://SEU-TUNEL.ngrok-free.app

# URL do frontend Lovable, para onde o OAuth redireciona apos conectar
FRONTEND_URL=http://localhost:5173

# Auth do dashboard (JWT via Devise-JWT)
DEVISE_JWT_SECRET_KEY=
